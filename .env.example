# Copy this file to .env and fill it in. Never commit .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Encrypts 2-step login keys and bill links. Make one with:
#   openssl rand -base64 48
# Keep a copy somewhere safe (not on the server). If it is lost or changed,
# bill links and everyone's 2-step login stop working.
APP_SECRET=

# The website address, used in WhatsApp posts and bill links.
SITE_URL=https://shivamobiles.in

# Docker Compose only: your domain (without https://) and a database password.
#   openssl rand -hex 24
SITE_DOMAIN=shivamobiles.in
POSTGRES_PASSWORD=

# Without Docker: your Postgres connection string (Docker Compose sets it for you).
# DATABASE_URL=postgres://user:password@host:5432/shiva

# ---------------------------------------------------------------------------
# First login
# ---------------------------------------------------------------------------

# Lets you create the owner account once at /admin/setup. Use 16+ random
# characters (openssl rand -hex 16). Remove it after the owner account exists.
SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Cloudflare Turnstile ("I am human" check) for the public forms. Free:
# https://dash.cloudflare.com → Turnstile → Add widget → your domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Recommended: a FREE AI model reads phone specs from Wikipedia when you type a
# model name, and remembers phones Wikipedia lacks. Only free models are ever
# used. https://openrouter.ai → Keys, and allow free models under Settings → Privacy.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free   (or any model ending in :free)

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Which header holds the visitor's real address (see README, "Visitor IP
# addresses"). Docker Compose sets x-real-ip for you.
# TRUSTED_IP_HEADER=
# TRUSTED_PROXY_HOPS=1

# Lets an outside scheduler run the daily clean-up: POST /api/cron/cleanup
# with "Authorization: Bearer <CRON_SECRET>". The admin panel also runs it.
# CRON_SECRET=

# DATABASE_POOL_MAX=5
